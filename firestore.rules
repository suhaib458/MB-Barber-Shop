rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || (
          exists(adminPath()) &&
          get(adminPath()).data.active == true &&
          get(adminPath()).data.role == 'admin'
        )
      );
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /services/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /barbers/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /instagramWorks/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /businessSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      allow read, write: if isAdmin();
    }

    match /slotLocks/{id} {
      allow read, write: if isAdmin();
    }

    match /customers/{id} {
      allow read, write: if isAdmin();
    }

    match /notificationTokens/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
